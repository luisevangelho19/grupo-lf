# Example environment variables for local development and production

# Base site URL used by next-sitemap / canonical links
SITE_URL=https://servicoslf.com.br

# Contact: WhatsApp-first setup (production uses WhatsApp CTAs)
# Destination phone used by client-side deep links (international format, no +)
# Example with country code (Brazil): 55 + area + number => 5562999999999
# The client-side app needs a public env var so the value is available in the browser.
NEXT_PUBLIC_SITE_WHATSAPP_NUMBER=5562991157746
# (Optional server-only var if you ever enable server-side flows)
# SITE_WHATSAPP_NUMBER=5562991157746
